PORT=8080
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174
GEMINI_API_KEY=your_server_gemini_key
GEMINI_MODEL=gemini-2.5-flash

# Option 1: Firebase service account JSON (recommended)
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"ai-pets-db01","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"...","client_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token","auth_provider_x509_cert_url":"https://www.googleapis.com/oauth2/v1/certs","client_x509_cert_url":"..."}

# Option 2: individual Firebase Admin credentials (if not using FIREBASE_SERVICE_ACCOUNT_JSON)
# FIREBASE_PROJECT_ID=ai-pets-db01
# FIREBASE_CLIENT_EMAIL=...
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
